# Copy this file to .env and replace the placeholder locally.
# Never commit the real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
BETTEROPTION_DATABASE_URL=sqlite:///local-data/betteroption.db
BETTEROPTION_LLM_PROVIDER=openai
BETTEROPTION_APP_ENVIRONMENT=local
# Required for online staging; leave empty for the local desktop workflow.
BETTEROPTION_PUBLIC_BASE_URL=
# Accounts own up to five passwordless personas. Each persona has independent
# Compass, saved-job, match, and application history. Keep the legacy local flag
# off; account-owned personas use the normal authenticated account boundary.
BETTEROPTION_AUTH_MODE=accounts
BETTEROPTION_ACCOUNT_PERSONAS_ENABLED=true
BETTEROPTION_PERSONA_LIMIT=5
BETTEROPTION_LOCAL_PERSONAS_ENABLED=false
# A fresh local database needs first_user for its owner bootstrap. Use open only
# while deliberately creating extra test accounts, then set disabled and restart.
BETTEROPTION_REGISTRATION_MODE=first_user
BETTEROPTION_AUTH_SESSION_DAYS=30
# Enable this only when the application is served through HTTPS.
BETTEROPTION_AUTH_SECURE_COOKIE=false
# Invitation and recovery tokens are random, hashed at rest, single-use, and
# expire after these periods.
BETTEROPTION_AUTH_INVITATION_HOURS=72
BETTEROPTION_AUTH_RECOVERY_MINUTES=60
# Authentication throttling stores only an HMAC of the normalized subject and
# client boundary. Generate a different secret per deployment:
#   openssl rand -hex 32
BETTEROPTION_AUTH_RATE_LIMIT_ATTEMPTS=8
BETTEROPTION_AUTH_RATE_LIMIT_MINUTES=15
BETTEROPTION_AUTH_RATE_LIMIT_SECRET=
# Leave false while the origin accepts direct Internet traffic. Enable only
# after direct origin access is restricted to Cloudflare or a trusted tunnel.
BETTEROPTION_AUTH_TRUST_CLOUDFLARE_HEADERS=false
# Automatic minimisation. These are maximum alpha values; use shorter periods
# only after updating the reviewed notice and retention schedule.
BETTEROPTION_RETENTION_WORKER_INTERVAL_HOURS=24
BETTEROPTION_RETENTION_TOKEN_RECORD_DAYS=7
BETTEROPTION_RETENTION_AUTH_ATTEMPT_DAYS=7
BETTEROPTION_RETENTION_RAW_COMPASS_DAYS=30
BETTEROPTION_RETENTION_PENDING_FACT_DAYS=30
BETTEROPTION_RETENTION_REJECTED_FACT_DAYS=7
BETTEROPTION_RETENTION_LEGACY_CV_HOURS=24
BETTEROPTION_RETENTION_PROVIDER_TELEMETRY_DAYS=90
BETTEROPTION_RETENTION_APPLICATION_DRAFT_DAYS=180
# Product feedback is account-owned, never sent to AI, and expires automatically.
BETTEROPTION_RETENTION_PRODUCT_FEEDBACK_DAYS=180
# Legacy bootstrap bridge for an installation upgraded from before database admin
# roles. It is consulted only while the database has no admin; DB roles take over
# permanently after the first promotion. Keep this setting outside source control.
BETTEROPTION_OPERATOR_EMAILS=
# Draft legal-document identity and versioning. Complete these with the real
# controller before any online alpha. Change a version whenever the corresponding
# reviewed document changes materially; existing accounts can acknowledge it in Account.
BETTEROPTION_LEGAL_OPERATOR_NAME=
BETTEROPTION_LEGAL_OPERATOR_ADDRESS=
BETTEROPTION_LEGAL_CONTACT_EMAIL=
BETTEROPTION_LEGAL_TERMS_VERSION=2026-08-02-draft
BETTEROPTION_LEGAL_PRIVACY_VERSION=2026-08-05-feedback-draft
# Readiness flags are operator assertions, not automated legal or security approval.
BETTEROPTION_LEGAL_REVIEW_COMPLETED=false
BETTEROPTION_PROCESSOR_REVIEW_COMPLETED=false
BETTEROPTION_INCIDENT_PLAN_READY=false
BETTEROPTION_BACKUP_RESTORE_TESTED=false
# Local preparation for a future verified employer-posting workflow. Local mode
# exposes the request/review boundary for testing; hosted use remains unavailable
# until this explicit flag and the legal/incident/operator gates are all ready.
BETTEROPTION_EMPLOYER_JOB_POSTING_ENABLED=false
# Optional task-specific overrides; otherwise OPENAI_MODEL is used.
# BETTEROPTION_PROFILE_MODEL=gpt-5.6-luna
# BETTEROPTION_JOB_MODEL=gpt-5.6-luna
# BETTEROPTION_MATCH_MODEL=gpt-5.6-luna
# BETTEROPTION_APPLICATION_DRAFT_MODEL=gpt-5.6-luna
# Optional semantic evidence checks receive only confirmed criteria that local
# deterministic Matching could not resolve for that job, plus canonical public
# job facts. Jobs are sent in fixed batches of five; 25 means at most five calls.
BETTEROPTION_MATCH_EVIDENCE_MAX_JOBS=25
# Optional one-batch salary research. It runs only when the confirmed Compass has
# a pay criterion and a European job omits pay. Public title/location/summary and
# extracted job facts go to restricted Web Search; no candidate profile is sent.
# BETTEROPTION_SALARY_RESEARCH_MODEL=gpt-5.6-luna
BETTEROPTION_SALARY_RESEARCH_ENABLED=true
BETTEROPTION_SALARY_RESEARCH_MAX_JOBS=10
BETTEROPTION_SALARY_RESEARCH_MAX_TOOL_CALLS=10
# OpenAI bills Web Search content tokens at the selected model's input rate.
# Its reviewed Responses guide currently documents a 128k search-context limit;
# reserve that once for the whole salary batch, not once per tool call. The
# low/default tool hints below are not treated as a numeric cost guarantee.
BETTEROPTION_SALARY_RESEARCH_SEARCH_CONTENT_TOKEN_CEILING=128000
BETTEROPTION_APPLICATION_BATCH_LIMIT=5
# Extract source-published application contacts and submission rules for the
# local guidance tile. Hosted environments still fail closed unless legal and
# processor review flags are both true.
BETTEROPTION_APPLICATION_GUIDANCE_ENABLED=true
# Current pricing inputs for the local usage estimate. Numeric settings must not
# be blank. Use 0 while the contract price is unknown; zero means unpriced, never
# free. Replace it with the current effective provider prices before invitations.
BETTEROPTION_OPENAI_INPUT_COST_PER_MILLION_USD=0
BETTEROPTION_OPENAI_OUTPUT_COST_PER_MILLION_USD=0
BETTEROPTION_MOBILITY_PROVIDER=auto
# privacy_first (default) keeps Google disabled in auto mode. balanced explicitly opts
# the deployment into Google-first routing when GOOGLE_ROUTES_API_KEY is configured.
BETTEROPTION_MOBILITY_PRIVACY_MODE=privacy_first
# Every explicit Matching run may calculate complete route evidence for all 25 saved jobs.
# Explore never calls a route provider; it uses offline approximate distance only.
BETTEROPTION_EXACT_ROUTE_MATCH_LIMIT=25
# Optional accuracy-first provider. Supports car, transit, bicycle, and walking routes.
# Only endpoints, mode, and departure time are sent server-side. CV, salary, profile text,
# account identity, and preference facts are never included. Google results are not persisted.
GOOGLE_ROUTES_API_KEY=
# Optional hosted open-source fallback for car, bicycle, and walking.
OPENROUTESERVICE_API_KEY=
# Keyless public-transit fallback for the private alpha. Results are cached for 12 hours.
# Contact Transitous or self-host MOTIS before commercial/paid production use.
BETTEROPTION_TRANSITOUS_ENABLED=true
BETTEROPTION_TRANSITOUS_BASE_URL=https://api.transitous.org
BETTEROPTION_TRANSITOUS_USER_AGENT=BetterOption/0.7.2k (+https://github.com/ILLVAN/betteroption)
# Keyless Google-free fallback for car, bicycle, and walking during private alpha.
# FOSSGIS permits at most one request/second and requires attribution plus an identifying
# client. Contact FOSSGIS or self-host Valhalla before commercial/paid production use.
BETTEROPTION_VALHALLA_ENABLED=true
BETTEROPTION_VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
BETTEROPTION_VALHALLA_CLIENT_ID=betteroption.example
BETTEROPTION_VALHALLA_USER_AGENT=BetterOption/0.7.2k (+https://github.com/ILLVAN/betteroption)
# Optional generic fallback for districts and addresses not found in the bundled
# postcode/city indexes. Only that unresolved place label is sent. Results are
# cached in memory and public-endpoint pacing is enforced. Self-host or contract
# a geocoder before paid production use.
BETTEROPTION_OSM_GEOCODER_ENABLED=true
BETTEROPTION_OSM_GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
BETTEROPTION_OSM_GEOCODER_USER_AGENT=BetterOption/0.7.2k (+https://github.com/ILLVAN/betteroption)
# Explore searches up to thirty recent Arbeitnow pages and keeps them in a short cache.
BETTEROPTION_ARBEITNOW_PAGES=30
# A complete configured-source run may take five to seven minutes. All providers
# start concurrently; raw web candidates then pass bounded source checks. Place,
# postcode, distance filtering, deduplication, and ranking stay local.
BETTEROPTION_DISCOVERY_SEARCH_BUDGET_SECONDS=390
BETTEROPTION_DISCOVERY_AVAILABILITY_BUDGET_SECONDS=35
BETTEROPTION_DISCOVERY_AVAILABILITY_MAX_CHECKS=120
BETTEROPTION_EXPLORE_PREVIEW_LIMIT=9
# Current local evaluation default: call every configured and account-enabled
# discovery source. Set false later to restore conditional Brave/You fallback.
BETTEROPTION_DISCOVERY_CALL_ALL_PROVIDERS=true
# Optional web-wide discovery through Brave's documented Web Search endpoint.
# This must be a key created under an active Brave Search plan. The separate
# Brave Answers product is not used and an Answers-only key cannot power Explore.
# Search results are only candidates; selected URLs still pass robots, safety,
# and reachability checks.
BRAVE_SEARCH_API_KEY=
# Do not add BRAVE_ANSWERS_API_KEY for BetterOption. If a legacy/local environment
# contains one, diagnostics report it as configured but unused without revealing it.
# Optional semantic discovery provider. BetterOption uses several concise role/location
# queries, then verifies every web result before it can appear in Explore.
EXA_API_KEY=
# Used only when BETTEROPTION_DISCOVERY_CALL_ALL_PROVIDERS=false. The former
# Exa-named variable remains a legacy alias.
BETTEROPTION_DISCOVERY_FALLBACK_MIN_RESULTS=60
# Exa keeps several focused queries, run concurrently inside this budget.
BETTEROPTION_EXA_SEARCH_BUDGET_SECONDS=140
# Optional one-call raw web-search source. It is absent when no key is configured,
# remains behind processor review and Account provider choices, and never uses live crawl.
# Canonical You.com Search credential. BETTEROPTION_YOU_SEARCH_API_KEY and the
# legacy YOU_SEARCH_API_KEY are accepted aliases for existing local files.
YDC_API_KEY=
# Optional structured job-search source. The key is sent only in the X-API-Key
# header. Each Explore run uses at most the configured number of focused role
# queries and the provider-wide deadline can stop before that maximum.
OPENWEBNINJA_JSEARCH_API_KEY=
BETTEROPTION_OPENWEBNINJA_JSEARCH_MAX_REQUESTS=3
BETTEROPTION_OPENWEBNINJA_JSEARCH_CONNECT_TIMEOUT_SECONDS=10
BETTEROPTION_OPENWEBNINJA_JSEARCH_READ_TIMEOUT_SECONDS=90
BETTEROPTION_OPENWEBNINJA_JSEARCH_SEARCH_BUDGET_SECONDS=120
# Optional structured Apify sources. The shared secret is sent only as a Bearer
# header, while EURES, JobsPipe, and All Jobs remain separate actors, permissions,
# operation rows, result labels, limits, and cost estimates.
APIFY_API_TOKEN=
BETTEROPTION_APIFY_EURES_MAX_RESULTS=30
BETTEROPTION_APIFY_JOBSPIPE_MAX_RESULTS=300
BETTEROPTION_APIFY_JOBSPIPE_POSTED_WITHIN_DAYS=60
# AgentX max_results is per platform and affects possible pay-per-event volume.
# maxItems only bounds readback/presentation; maxTotalChargeUsd is the charge cap.
# Leave platforms blank to use every platform the actor supports for the country.
BETTEROPTION_APIFY_ALL_JOBS_MAX_RESULTS_PER_PLATFORM=20
BETTEROPTION_APIFY_ALL_JOBS_MAX_ITEMS=120
BETTEROPTION_APIFY_ALL_JOBS_POSTED_SINCE=30 days
BETTEROPTION_APIFY_ALL_JOBS_PLATFORMS=
BETTEROPTION_APIFY_ALL_JOBS_MAX_TOTAL_CHARGE_USD=0.40
# Local runs are available now. Hosted staging/production remains greyed out
# until this actor-specific review switch and the global processor review pass.
BETTEROPTION_APIFY_ALL_JOBS_HOSTED_ENABLED=false
# Optional direct public ATS boards. Use semicolon-separated Company=token pairs.
# Lever EU boards use Company=eu:site-token.
BETTEROPTION_GREENHOUSE_BOARDS=
BETTEROPTION_LEVER_SITES=
BETTEROPTION_ASHBY_BOARDS=
BETTEROPTION_ATS_EXPANSION_ENABLED=true
BETTEROPTION_ATS_EXPANSION_MAX_BOARDS=20
# Optional public employer homepage check. Set false for an offline-only development run.
BETTEROPTION_EMPLOYER_HOMEPAGE_RESEARCH=true
# Privacy-safe provider guards. Set 0 to disable a limit. A conservative metadata-only
# reservation is committed before outbound I/O and survives web/worker restarts; it stores
# only provider, purpose, time, outcome, units, result count and configured cost estimate.
BETTEROPTION_PROVIDER_DAILY_OPERATION_LIMIT=1000
BETTEROPTION_PROVIDER_DAILY_COST_LIMIT_USD=0
# A second rail caps one correlated workflow such as a complete Matching run.
# It prevents one retry or large Archive from consuming the complete daily allowance.
BETTEROPTION_PROVIDER_ACTION_OPERATION_LIMIT=200
BETTEROPTION_PROVIDER_ACTION_COST_LIMIT_USD=0
# Persistent background workflow controls. Local single-process use runs the embedded
# worker (ENABLED=true, EXTERNAL=false). Server Compose runs the separate PostgreSQL-backed
# worker service (ENABLED=false, EXTERNAL=true). Never enable both modes at once.
BETTEROPTION_BACKGROUND_WORKER_ENABLED=true
BETTEROPTION_BACKGROUND_WORKER_EXTERNAL=false
BETTEROPTION_BACKGROUND_WORKER_POLL_SECONDS=0.5
BETTEROPTION_BACKGROUND_TASK_MAX_ATTEMPTS=2
BETTEROPTION_BACKGROUND_TASK_RETRY_SECONDS=2
BETTEROPTION_BACKGROUND_TASK_LEASE_TTL_SECONDS=30
BETTEROPTION_BACKGROUND_TASK_HEARTBEAT_SECONDS=5
# Pricing changes over time, so estimates are operator-configured rather than hardcoded.
# Enter your current effective per-operation estimates to make the dashboard cost useful.
# The legacy discovery estimate remains a fallback when a provider-specific value is zero.
BETTEROPTION_DISCOVERY_ESTIMATED_COST_PER_SEARCH_USD=0
BETTEROPTION_BRAVE_SEARCH_ESTIMATED_COST_PER_CALL_USD=0
BETTEROPTION_EXA_SEARCH_ESTIMATED_COST_PER_CALL_USD=0
BETTEROPTION_YOU_SEARCH_ESTIMATED_COST_PER_CALL_USD=0
BETTEROPTION_OPENWEBNINJA_JSEARCH_ESTIMATED_COST_PER_CALL_USD=0
BETTEROPTION_APIFY_EURES_ESTIMATED_COST_PER_RUN_USD=0
BETTEROPTION_APIFY_JOBSPIPE_ESTIMATED_COST_PER_RUN_USD=0
BETTEROPTION_APIFY_ALL_JOBS_ESTIMATED_COST_PER_RUN_USD=0.40
BETTEROPTION_COMPANY_RESEARCH_ESTIMATED_COST_PER_CALL_USD=0
# Per Web Search tool call. Before the Responses request, the salary batch adds
# this tool-call ceiling to conservative model input/output token ceilings
# calculated from the two OPENAI_*_COST_PER_MILLION_USD settings above.
BETTEROPTION_SALARY_RESEARCH_ESTIMATED_COST_PER_CALL_USD=0
BETTEROPTION_GOOGLE_ROUTES_ESTIMATED_COST_PER_CALL_USD=0
BETTEROPTION_WEB_HOST=127.0.0.1
BETTEROPTION_WEB_PORT=8000
# Secret-safe effective-settings check. It also reports duplicate .env keys:
# .\.venv\Scripts\python.exe scripts\diagnose_config.py
# One fixed Brave Web Search request (uses one Search-plan request, no user text):
# .\.venv\Scripts\python.exe scripts\diagnose_config.py --probe-brave-search
# OpenAI authentication/model-access check (no Compass or CV text):
# .\.venv\Scripts\python.exe scripts\diagnose_openai.py
